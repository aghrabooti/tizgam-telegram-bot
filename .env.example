# نمونه‌ی تنظیمات اجرای ربات
# این فایل را به .env کپی کنید و مقادیر واقعی را وارد کنید.

# توکن ربات (از @BotFather)
BOT_TOKEN=123456789:AAF...your-bot-token

# شناسه‌ی عددی مدیران ربات، با کاما جدا کنید (برای /admin و پنل مدیریت)
# شناسه‌ی خودتان را با فرمان /id از خود ربات بگیرید.
ADMIN_IDS=123456789

# مسیر دیتابیس (آمار + مقادیر ویرایش‌شده‌ی محتوا) — اختیاری
# DATABASE_PATH=data/tizgam.db

# سطح لاگ (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
